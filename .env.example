# Chỉ dùng khi chạy thử trên máy: cp .env.example .env rồi điền giá trị.
# Trên GitHub Actions, các biến này đặt trong Settings -> Secrets and variables -> Actions.

# --- Secrets ---
WEATHER_API_KEY=
AI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Variables ---
# Địa điểm mặc định (dùng khi chưa có location.json): tên thành phố hoặc "lat,lon"
LOCATION=Hanoi
TIMEZONE=Asia/Ho_Chi_Minh
AI_MODEL=gemini-3.8-flash
LANGUAGE=vi
